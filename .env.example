# Copia este archivo como .env.local para correr el proyecto en tu computadora.
# En Vercel, estas mismas variables van en el proyecto → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta (empieza con sb_secret_). Solo servidor; nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Para desarrollo sin internet hacia Supabase: `npm run supabase:local` y usa
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local
# SUPABASE_SECRET_KEY=sb_secret_local   (el código para entrar siempre es 123456)

# Mercado Pago → Tus integraciones → tu aplicación. Mientras sea prueba: credenciales de la
# cuenta de prueba vendedora.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
# Tus integraciones → tu aplicación → Webhooks → clave secreta
MERCADOPAGO_WEBHOOK_SECRET=xxx
# Correo al negocio por cada reserva: el Gmail del negocio y su contraseña de aplicación
# (myaccount.google.com/apppasswords; necesita la verificación en 2 pasos). Le llega a
# cualquiera. Los mismos dos valores van como secretos de GitHub para el código de acceso.
GMAIL_USER=negocio@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Sin Gmail se usa Resend → API Keys (su remitente de prueba solo le llega al dueño de la
# cuenta de Resend).
RESEND_API_KEY=re_xxx

# `npm run supabase:local` también imita Mercado Pago y Resend (sin GMAIL_USER, para que
# los correos lleguen a la imitación de Resend):
# MERCADOPAGO_API_URL=http://127.0.0.1:54321/mercadopago
# MERCADOPAGO_ACCESS_TOKEN=local-mercadopago-token
# MERCADOPAGO_WEBHOOK_SECRET=local-webhook-secret
# RESEND_API_URL=http://127.0.0.1:54321/resend/emails
# RESEND_API_KEY=local-resend-key
