# Copia este archivo como .env.local para correr el proyecto en tu computadora.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta (empieza con sb_secret_). Solo servidor; nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Para desarrollo sin internet hacia Supabase: `npm run supabase:local` y usa
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local
# SUPABASE_SECRET_KEY=sb_secret_local   (el código para entrar siempre es 123456)
